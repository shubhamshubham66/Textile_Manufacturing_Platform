# Copy this file to .env and fill in the values. Never commit .env.

# ---- Database (optional) ----
# Defaults to a local SQLite file if unset. For PostgreSQL use e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/textile
DATABASE_URL=

# On start: create tables, and load demo data if the database is empty.
# AUTO_CREATE_TABLES=true
# SEED_IF_EMPTY=true

# ---- Auth / JWT ----
# Set a long random secret for any real deployment. Dev has an insecure default.
JWT_SECRET=
# JWT_EXPIRE_MINUTES=720

# ---- Owner login ----
# The real owner's Gmail + password. On start the API makes this an owner
# account (or updates its password). Set on the host only; never commit.
OWNER_EMAIL=
OWNER_PASSWORD=
# OWNER_NAME=Owner

# ---- Signup email OTP (Brevo) ----
# Brevo HTTP API key and a sender address verified in Brevo. Without these,
# "Send OTP" on /signup returns "Email sending is not set up on the server yet".
BREVO_API_KEY=
MAIL_FROM_EMAIL=
# MAIL_FROM_NAME=Everest Textile Mills
# Local development only: with no Brevo key, show the code on the signup page.
# SIGNUP_DEV_OTP=false

# ---- Dify AI assistant (used server-side only) ----
DIFY_API_KEY=
DIFY_BASE_URL=

# ---- CORS (only if the browser calls the API directly) ----
# CORS_ORIGINS=http://localhost:5173
